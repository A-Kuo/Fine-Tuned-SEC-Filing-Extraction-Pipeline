# Copy to .env and fill in values
# cp .env.example .env

# HuggingFace (for model download)
HF_TOKEN=your_huggingface_token_here

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=finllm
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=financial_llm

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Monitoring
ALERT_EMAIL=

# MLFlow / DagsHub (experiment tracking + model registry)
# Generate a token at: https://dagshub.com/user/settings/tokens
DAGSHUB_USER_TOKEN=your_dagshub_token_here
MLFLOW_TRACKING_URI=https://dagshub.com/A-Kuo/Fine-Tuned-SEC-Filing-Extraction-Pipeline.mlflow

# Kaggle (primary remote training compute; local GPU is the fallback)
# Generate a token at: https://www.kaggle.com/settings -> API -> Generate New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
# Preferred for kaggle CLI v2+ (kernels pull/push). Can use instead of username/key.
KAGGLE_API_TOKEN=your_kaggle_api_token_here
