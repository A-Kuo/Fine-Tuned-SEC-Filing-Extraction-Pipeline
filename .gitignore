# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# ─── Virtual Environments ────────────────────────────────────────────────────
.venv/
venv/
env/

# ─── IDE ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
*.code-workspace

# ─── Cursor IDE ───────────────────────────────────────────────────────────────
# Keep .cursor/CLAUDE.md (project agent context) but exclude installed skills
# and any personal IDE config that doesn't belong in the project repo
.cursor/skills/
.cursor/rules/

# ─── Testing ─────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# ─── Project Artifacts ───────────────────────────────────────────────────────
# Model weights and checkpoints (large binary files)
models/
!models/.gitkeep
results/
!results/.gitkeep

# Raw Kaggle kernel output download (weights, logs) -- scratch only;
# scripts/fetch_kaggle_results.py extracts metrics.json/plot from this.
.kaggle_output/

# Generated data (reproducible via scripts/download_dataset.py + format_data.py)
data/*.jsonl
# Keep sample reference files
!data/sample_10k.txt
!data/sample_10k.expected.json

# EDGAR downloads (reproducible via scripts/fetch_edgar.py)
data/raw_edgar/

# ─── Secrets (never commit real credentials) ─────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ─── Personal / resume material (never belongs in a public-facing repo) ──────
docs/RESUME_SAFE_CLAIMS.md
**/*resume*
**/*RESUME*
**/*_CV_*
**/*_CV.*

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
research/

# Repomix
repomix-output.xml

# ─── Session audit trail (agent-generated, not public-facing docs) ───────────
docs/TRUTH_AUDIT.md
docs/UPGRADE_REPORT.md
docs/NEXT_EXPERIMENTS.md

# ─── Agent/tooling instructions (not user-facing) ─────────────────────────────
# NOTE: MODEL_CARD.md and docs/API_CONTRACTS.md were deliberately kept OUT of
# this list -- both are real public-facing docs (a model card, an API design
# doc) linked from README.md/CITATION.cff, not agent scratch files.
AGENTS.md
research/AGENT_RESEARCH_*.md
AGENTS.md
/research
